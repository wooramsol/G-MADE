# PostgreSQL connection for Prisma
DATABASE_URL="postgresql://gmade:gmade@localhost:5432/gmade_hybrid_evaluation"

# Internal login (no email verification)
AUTH_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="admin@gmadehive.com"
ADMIN_PASSWORD="gmadehive-admin"
ADMIN_INITIAL_PASSWORD="gmadehive-admin"

# VWorld spatial APIs (경관지구 lt_c_uq121)
VWORLD_API_KEY=""
VWORLD_DOMAIN="www.gmadehive.com"
# Set to false only when debugging server-side domain parameter issues
VWORLD_SEND_DOMAIN="true"

# 국가법령정보센터 Open API (https://open.law.go.kr)
# OC = 신청 이메일 ID (예: abc@email.com → abc)
LAW_OC=""
# Referer 없으면 API 거부될 수 있음 (기본: VWORLD_DOMAIN 기반)
LAW_REFERER="https://www.gmadehive.com"

# Default AI provider for upload analysis (gemini | openai | claude | demo)
AI_PROVIDER_DEFAULT="gemini"

# Optional OpenAI integration point for production AI document analysis
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash-lite"
# Optional Claude (Anthropic) integration
CLAUDE_API_KEY=""
CLAUDE_MODEL="claude-sonnet-4-6"

# S3-compatible storage configuration
S3_ENDPOINT="https://s3.amazonaws.com"
S3_REGION="ap-northeast-2"
S3_BUCKET="g-made-hybrid-evaluation-system"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
